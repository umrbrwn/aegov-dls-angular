{
  "name": "aegov-dls-angular",
  "version": "0.1.0",
  "description": "Unofficial, community-driven Angular port of the UAE Government Design Language System (@aegov/design-system).",
  "scripts": {
    "postinstall": "node scripts/generate-icons.cjs",
    "storybook": "ng run aegov-dls-angular:storybook",
    "build-storybook": "ng run aegov-dls-angular:build-storybook",
    "build:styles": "node scripts/build-styles.cjs",
    "build": "ng-packagr -p ng-package.json && npm run build:styles",
    "watch": "ng-packagr -p ng-package.json --watch"
  },
  "keywords": [
    "design-system",
    "design system",
    "designsystem",
    "dls",
    "design language",
    "angular",
    "angular components",
    "component-library",
    "tailwind",
    "tailwind v4",
    "components",
    "component library",
    "uae",
    "united arab emirates",
    "aegov",
    "tdra",
    "community-fork",
    "unofficial"
  ],
  "author": "Muhammad Umar (Community Maintainer)",
  "contributors": [
    "Muhammad Umar"
  ],
  "license": "MIT",
  "homepage": "https://github.com/umrbrwn/aegov-dls-angular#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umrbrwn/aegov-dls-angular.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/cdk": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/router": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@angular/cdk": "^19.1.5",
    "@angular/cli": "^19.1.5",
    "@angular/common": "^19.1.5",
    "@angular/compiler": "^19.1.5",
    "@angular/compiler-cli": "^19.1.5",
    "@angular/core": "^19.1.5",
    "@angular/forms": "^19.1.5",
    "@angular/platform-browser": "^19.1.5",
    "@angular/platform-browser-dynamic": "^19.1.5",
    "@angular/router": "^19.1.5",
    "@phosphor-icons/core": "^2.1.1",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/angular": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@tailwindcss/postcss": "^4.0.9",
    "ng-packagr": "^19.1.2",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "style-loader": "^4.0.0",
    "css-loader": "^7.1.2",
    "storybook": "^8.6.0",
    "tailwindcss": "^4.0.9",
    "tslib": "^2.8.1",
    "typescript": "~5.7.3",
    "zone.js": "~0.15.0"
  }
}
